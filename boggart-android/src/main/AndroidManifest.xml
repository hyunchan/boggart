<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <activity
            android:name="io.github.hyunchan.boggart.android.BoggartActivity"
            android:exported="false"
            android:label="Boggart"
            android:launchMode="singleTop"
            android:theme="@style/Boggart.Theme" />

        <!-- 자동 설치. 앱은 이 meta-data를 tools:node="remove"로 지워 끌 수 있다. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="io.github.hyunchan.boggart.android.BoggartInitializer"
                android:value="androidx.startup" />
        </provider>
    </application>

</manifest>
